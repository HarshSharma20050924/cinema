{
  "name": "cinema-desktop",
  "productName": "Cinema",
  "version": "4.1.0",
  "description": "High-Performance Standalone Desktop Cinema Streaming App",
  "author": "Harsh Sharma",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshSharma20050924/cinema.git"
  },
  "main": "main.cjs",
  "scripts": {
    "prepare-assets": "node ../scripts/prepare-desktop.cjs",
    "predist:linux": "npm run prepare-assets",
    "predist:win": "npm run prepare-assets",
    "predist:mac": "npm run prepare-assets",
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:all": "electron-builder -wlm --publish never"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cinema.streaming",
    "productName": "Cinema",
    "copyright": "Copyright © 2026 Cinema",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server/**/*",
      "dist/**/*",
      "public/**/*"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cinema"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-portable.${ext}"
    },
    "linux": {
      "executableName": "cinema-desktop",
      "executableArgs": ["--no-sandbox"],
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "AudioVideo",
      "icon": "public/logo.png",
      "maintainer": "Cinema Team"
    },
    "deb": {
      "afterInstall": "build-scripts/after-install.sh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "identity": null,
      "category": "public.app-category.entertainment",
      "icon": "public/logo.png",
      "darkModeSupport": true
    }
  }
}
